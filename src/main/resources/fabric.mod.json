{
  "schemaVersion": 1,
  "id": "copper_golem_mod",
  "version": "${version}",
  "name": "Copper Golem Optimisation",
  "description": "Cuts the server lag of copper golems in big sorting farms. Golems sort exactly as in vanilla; the work behind it is just done more cheaply.",
  "authors": [
    "RestfulBee"
  ],
  "contact": {
    "homepage": "https://github.com/Restfulbee37/copper-golem-optimisation",
    "sources": "https://github.com/Restfulbee37/copper-golem-optimisation",
    "issues": "https://github.com/Restfulbee37/copper-golem-optimisation/issues"
  },
  "license": "MIT",
  "icon": "assets/copper_golem_mod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.restfulbee.coppergolemmod.CopperGolemMod"
    ]
  },
  "mixins": [
    "copper_golem_mod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=25"
  }
}
